local function createBuilding(Position, HasAntenna)

	local Model = Instance.new("Model")
	Model.Name = "Predio_Do_Evento"
	Model.Parent = workspace

	local Floors = math.floor(
		BUILDING_HEIGHT / FLOOR_HEIGHT
	)

	local BlocksX = math.floor(
		BUILDING_WIDTH / BLOCK_SIZE
	)

	local BlocksZ = math.floor(
		BUILDING_DEPTH / BLOCK_SIZE
	)

	for Floor = 0, Floors - 1 do

		local Y =
			Position.Y
			+
			(Floor * FLOOR_HEIGHT)
			+
			(FLOOR_HEIGHT / 2)

		for X = 0, BlocksX - 1 do

			for Z = 0, BlocksZ - 1 do

				local Edge =
					X == 0
					or X == BlocksX - 1
					or Z == 0
					or Z == BlocksZ - 1

				local Support =
					X % 3 == 0
					and Z % 3 == 0

				if Edge or Support then

					local PX =
						Position.X
						-
						BUILDING_WIDTH / 2
						+
						(BLOCK_SIZE / 2)
						+
						(X * BLOCK_SIZE)

					local PZ =
						Position.Z
						-
						BUILDING_DEPTH / 2
						+
						(BLOCK_SIZE / 2)
						+
						(Z * BLOCK_SIZE)

					createBlock(
						Model,
						Vector3.new(PX,Y,PZ),
						Vector3.new(
							BLOCK_SIZE,
							FLOOR_HEIGHT,
							BLOCK_SIZE
						),
						Color3.fromRGB(
							145,
							145,
							145
						),
						Enum.Material.Concrete
					)
				end
			end
		end
	end

	-- Piso inferior
	createBlock(
		Model,
		Vector3.new(
			Position.X,
			Position.Y + FLOOR_HEIGHT / 2,
			Position.Z
		),
		Vector3.new(
			BUILDING_WIDTH,
			FLOOR_HEIGHT,
