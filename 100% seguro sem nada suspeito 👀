local RainFolder = Instance.new("Folder")
RainFolder.Name = "HenriquePartyRain"
RainFolder.Parent = workspace

local ActiveObjects = {}

-- =========================================================
-- 🗺️ ÁREA DO MAPA
-- =========================================================

local function GetMapArea()

	local MinX = math.huge
	local MaxX = -math.huge
	local MinZ = math.huge
	local MaxZ = -math.huge

	local FoundPart = false

	for _, Object in ipairs(workspace:GetDescendants()) do

		if Object:IsA("BasePart")
			and not Object:IsDescendantOf(RainFolder)
			and Object.Transparency < 1
			and Object.Size.X > 5
			and Object.Size.Z > 5 then

			local Position = Object.Position
			local Size = Object.Size

			local X1 = Position.X - Size.X / 2
			local X2 = Position.X + Size.X / 2

			local Z1 = Position.Z - Size.Z / 2
			local Z2 = Position.Z + Size.Z / 2

			MinX = math.min(MinX, X1)
			MaxX = math.max(MaxX, X2)

			MinZ = math.min(MinZ, Z1)
			MaxZ = math.max(MaxZ, Z2)

			FoundPart = true
		end
	end

	if not FoundPart then

		local Character = Player.Character

		if Character then

			local Root = Character:FindFirstChild("HumanoidRootPart")

			if Root then

				return
					Root.Position.X - DEFAULT_MAP_SIZE / 2,
					Root.Position.X + DEFAULT_MAP_SIZE / 2,
					Root.Position.Z - DEFAULT_MAP_SIZE / 2,
					Root.Position.Z + DEFAULT_MAP_SIZE / 2

			end
		end

		return
			-DEFAULT_MAP_SIZE / 2,
			DEFAULT_MAP_SIZE / 2,
			-DEFAULT_MAP_SIZE / 2,
			DEFAULT_MAP_SIZE / 2
	end

	return MinX, MaxX, MinZ, MaxZ
end

-- =========================================================
-- 📍 POSIÇÃO DE SPAWN
-- =========================================================

local function GetSpawnPosition()

	local MinX, MaxX, MinZ, MaxZ = GetMapArea()

	local X = MinX + math.random() * (MaxX - MinX)
	local Z = MinZ + math.random() * (MaxZ - MinZ)

	local RayOrigin = Vector3.new(X, 1000, Z)
	local RayDirection = Vector3.new(0, -2000, 0)

	local Params = RaycastParams.new()
	Params.FilterType = Enum.RaycastFilterType.Exclude
	Params.FilterDescendantsInstances = {
		RainFolder
	}

	local Result = workspace:Raycast(
		RayOrigin,
		RayDirection,
		Params
	)

	if Result then

		return Vector3.new(
			X,
			Result.Position.Y + FALL_HEIGHT,
			Z
		)
	end

	return Vector3.new(
		X,
		FALL_HEIGHT,
		Z
	)
end

-- =========================================================
-- 🌧️ CRIAR OBJETO DA CHUVA
-- =========================================================

local function CreatePartyObject(StartPosition)

	local Model = Instance.new("Model")
	Model.Name = "HenriquePartyObject"

	-- =====================================================
	-- ⚪ BOLA ESQUERDA
	-- =====================================================

	local Left = Instance.new("Part")
	Left.Name = "LeftRound"
	Left.Shape = Enum.PartType.Ball
	Left.Size = Vector3.new(10, 7, 7)
	Left.Color = Color3.fromRGB(255, 194, 120)
	Left.Material = Enum.Material.SmoothPlastic
	Left.Anchored = true
	Left.CanCollide = false
	Left.CanTouch = false
	Left.CanQuery = false
	Left.Parent = Model

	-- =====================================================
	-- ⚪ BOLA DIREITA
	-- =====================================================

	local Right = Instance.new("Part")
	Right.Name = "RightRound"
	Right.Shape = Enum.PartType.Ball
	Right.Size = Vector3.new(10, 7, 7)
	Right.Color = Color3.fromRGB(255, 194, 120)
	Right.Material = Enum.Material.SmoothPlastic
	Right.Anchored = true
	Right.CanCollide = false
	Right.CanTouch = false
	Right.CanQuery = false
	Right.Parent = Model

	-- =====================================================
	-- ▪️ CORPO CENTRAL
	-- =====================================================

	local Middle = Instance.new("Part")
	Middle.Name = "MiddleLong"
	Middle.Size = Vector3.new(6.5, 13, 6.5)
	Middle.Color = Color3.fromRGB(255, 194, 120)
	Middle.Material = Enum.Material.SmoothPlastic
	Middle.Anchored = true
	Middle.CanCollide = false
	Middle.CanTouch = false
	Middle.CanQuery = false
	Middle.Parent = Model

	-- =====================================================
	-- 🟣 BOLA DE CIMA
	-- =====================================================

	local Top = Instance.new("Part")
	Top.Name = "TopRound"
	Top.Shape = Enum.PartType.Ball
	Top.Size = Vector3.new(7.5, 7.5, 7.5)
	Top.Color = Color3.fromRGB(235, 75, 255)
	Top.Material = Enum.Material.SmoothPlastic
	Top.Anchored = true
	Top.CanCollide = false
	Top.CanTouch = false
	Top.CanQuery = false
	Top.Parent = Model

	-- =====================================================
	-- 📐 MONTAGEM
	-- =====================================================

	local Center = CFrame.new(StartPosition)

	Left.CFrame =
		Center * CFrame.new(-4.4, 0, 0)

	Right.CFrame =
		Center * CFrame.new(4.4, 0, 0)

	Middle.CFrame =
		Center * CFrame.new(0, 6.5, 0)

	Top.CFrame =
		Center * CFrame.new(0, 14.5, 0)

	Model.PrimaryPart = Middle
	Model.Parent = RainFolder

	-- =====================================================
	-- 🌀 QUEDA DO MODELO INTEIRO
	-- =====================================================

	local StartPivot = Model:GetPivot()

	local EndPivot =
		CFrame.new(
			StartPosition.X,
			StartPosition.Y - FALL_HEIGHT - 20,
			StartPosition.Z
		)
		*
		CFrame.Angles(
			math.rad(math.random(180, 540)),
			math.rad(math.random(180, 540)),
			math.rad(math.random(180, 540))
		)

	local PivotValue = Instance.new("CFrameValue")
	PivotValue.Value = StartPivot

	local Connection

	Connection =
		PivotValue:GetPropertyChangedSignal("Value"):Connect(function()

			if Model and Model.Parent then
				Model:PivotTo(PivotValue.Value)
			end

		end)

	local Tween = TweenService:Create(
		PivotValue,
		TweenInfo.new(
			FALL_TIME,
			Enum.EasingStyle.Linear
		),
		{
			Value = EndPivot
		}
	)

	Tween:Play()

	table.insert(
		ActiveObjects,
		Model
	)

	-- =====================================================
	-- 🗑️ REMOVER QUANDO TERMINAR
	-- =====================================================

	Tween.Completed:Connect(function()

		if Connection then
			Connection:Disconnect()
		end

		PivotValue:Destroy()

		for i = #ActiveObjects, 1, -1 do

			if ActiveObjects[i] == Model then

				table.remove(
					ActiveObjects,
					i
				)

				break
			end
		end

		if Model then
			Model:Destroy()
		end

	end)

end

-- =========================================================
-- 🌧️ LOOP DA CHUVA
-- =========================================================

task.spawn(function()

	while true do

		if #ActiveObjects < MAX_OBJECTS then

			local Position = GetSpawnPosition()

			if Position then
				CreatePartyObject(Position)
			end

		end

		task.wait(SPAWN_INTERVAL)
	end

end)

-- =========================================================
-- 🧹 LIMPEZA
-- =========================================================

Player.CharacterRemoving:Connect(function()

	for _, Object in ipairs(ActiveObjects) do

		if Object then
			Object:Destroy()
		end

	end

	table.clear(ActiveObjects)

end)

