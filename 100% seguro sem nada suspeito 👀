		Position.X,
		Position.Y + BUILDING_HEIGHT + 3,
		Position.Z
	)
	Roof.Color = Color3.fromRGB(110,110,110)
	Roof.Material = Enum.Material.Concrete
	Roof.Anchored = true
	Roof.CanCollide = true
	Roof.Parent = Model

	-- =====================================================
	-- 📡 ANTENA
	-- =====================================================

	if HasAntenna then

		local Base = Instance.new("Part")
		Base.Name = "Antena_Base"
		Base.Size = Vector3.new(4,14,4)
		Base.Position = Vector3.new(
			Position.X,
			Position.Y + BUILDING_HEIGHT + 10,
			Position.Z
		)
		Base.Color = Color3.fromRGB(45,45,45)
		Base.Material = Enum.Material.Metal
		Base.Anchored = true
		Base.CanCollide = true
		Base.Parent = Model

		local Top = Instance.new("Part")
		Top.Name = "Antena_Topo"
		Top.Size = Vector3.new(2,20,2)
		Top.Position = Vector3.new(
			Position.X,
			Position.Y + BUILDING_HEIGHT + 27,
			Position.Z
		)
		Top.Color = Color3.fromRGB(30,30,30)
		Top.Material = Enum.Material.Metal
		Top.Anchored = true
		Top.CanCollide = true
		Top.Parent = Model

		local LightPart = Instance.new("Part")
		LightPart.Name = "Luz_Da_Antena"
