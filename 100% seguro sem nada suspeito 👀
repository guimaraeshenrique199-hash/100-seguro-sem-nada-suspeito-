-- =========================================================
-- 🗺️ ÁREA DO MAPA
-- =========================================================

local function GetMapArea()

	local MinX = math.huge
	local MaxX = -math.huge
	local MinZ = math.huge
	local MaxZ = -math.huge

	local FoundPart = false

	for _, Object in ipairs(workspace:GetDescendants()) do

		if Object:IsA("BasePart")
			and not Object:IsDescendantOf(RainFolder)
			and Object.Transparency < 1
			and Object.Size.X > 5
			and Object.Size.Z > 5 then

			local Position = Object.Position
			local Size = Object.Size

			MinX = math.min(MinX, Position.X - Size.X / 2)
			MaxX = math.max(MaxX, Position.X + Size.X / 2)

			MinZ = math.min(MinZ, Position.Z - Size.Z / 2)
			MaxZ = math.max(MaxZ, Position.Z + Size.Z / 2)

			FoundPart = true
		end
	end

	if not FoundPart then

		local Character = Player.Character

		if Character then

			local Root = Character:FindFirstChild("HumanoidRootPart")

			if Root then

				return
					Root.Position.X - DEFAULT_MAP_SIZE / 2,
					Root.Position.X + DEFAULT_MAP_SIZE / 2,
					Root.Position.Z - DEFAULT_MAP_SIZE / 2,
					Root.Position.Z + DEFAULT_MAP_SIZE / 2
			end
		end

		return
			-DEFAULT_MAP_SIZE / 2,
			DEFAULT_MAP_SIZE / 2,
			-DEFAULT_MAP_SIZE / 2,
			DEFAULT_MAP_SIZE / 2
	end

	return MinX, MaxX, MinZ, MaxZ
end

-- =========================================================
-- 📍 SPAWN DA CHUVA
-- =========================================================

local function GetSpawnPosition()

	local MinX, MaxX, MinZ, MaxZ = GetMapArea()

	local X = MinX + math.random() * (MaxX - MinX)
	local Z = MinZ + math.random() * (MaxZ - MinZ)

	local RayOrigin = Vector3.new(X, 1000, Z)
	local RayDirection = Vector3.new(0, -2000, 0)

	local Params = RaycastParams.new()
	Params.FilterType = Enum.RaycastFilterType.Exclude
	Params.FilterDescendantsInstances = {
		RainFolder
	}

	local Result = workspace:Raycast(
		RayOrigin,
		RayDirection,
		Params
	)

	if Result then

		return Vector3.new(
			X,
			Result.Position.Y + FALL_HEIGHT,
			Z
		)
	end

	return Vector3.new(
		X,
		FALL_HEIGHT,
		Z
	)
end

