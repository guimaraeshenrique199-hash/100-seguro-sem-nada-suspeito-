local function createExplosion(Position)

	local ExplosionPart = Instance.new("Part")
	ExplosionPart.Name = "Explosao_Do_Evento"
	ExplosionPart.Shape = Enum.PartType.Ball
	ExplosionPart.Size = Vector3.new(12,12,12)
	ExplosionPart.Position = Position
	ExplosionPart.Color = Color3.fromRGB(255,110,0)
	ExplosionPart.Material = Enum.Material.Neon
	ExplosionPart.Anchored = true
	ExplosionPart.CanCollide = false
	ExplosionPart.CanTouch = false
	ExplosionPart.CanQuery = false
	ExplosionPart.Parent = workspace

	local Light = Instance.new("PointLight")
	Light.Color = Color3.fromRGB(255,90,0)
	Light.Brightness = 18
	Light.Range = 80
	Light.Parent = ExplosionPart

	local Tween = TweenService:Create(
		ExplosionPart,
		TweenInfo.new(
			0.9,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Size = Vector3.new(65,65,65),
			Transparency = 1
		}
	)

	Tween:Play()

	Tween.Completed:Connect(function()
		ExplosionPart:Destroy()
	end)
end

-- =========================================================
-- 🏢 DESTRUIR PRÉDIO
-- =========================================================

local function destroyBuilding(
	Building,
	ImpactPosition
)

	createExplosion(ImpactPosition)

	task.wait(0.35)

	local Parts = {}

	for _, Object in ipairs(
		Building:GetDescendants()
	) do

		if Object:IsA("BasePart")
			and Object.Name ~= "Luz_Da_Antena" then

			table.insert(
				Parts,
				Object
			)

			local Distance =
				(
					Object.Position
					-
					ImpactPosition
				).Magnitude

			if Distance <= BLACK_RADIUS then

				Object.Material =
					Enum.Material.Slate

				Object.Color =
					Color3.fromRGB(
						15,
						15,
						15
					)
			end

			if Distance <= FIRE_RADIUS then
				addFireToBlock(Object)
			end
		end
	end

	task.wait(0.8)

	for _, Part in ipairs(Parts) do

		if Part
			and Part.Parent then

			local Distance =
				(
					Part.Position
					-
					ImpactPosition
				).Magnitude

			if Distance <= IMPACT_RADIUS then

				task.delay(
					math.random() * 0.7,
					function()

						if Part
							and Part.Parent then

							Part.Anchored = false

							local Direction =
								Part.Position
								-
								ImpactPosition

							if Direction.Magnitude < 0.1 then
								Direction =
									Vector3.new(
										math.random()-0.5,
										0,
										math.random()-0.5
									)
							end

							Direction =
								Direction.Unit

							Part.AssemblyLinearVelocity =
								Direction
								*
								math.random(28,60)
								+
								Vector3.new(
									0,
									math.random(8,30),
									0
								)

							Part.AssemblyAngularVelocity =
								Vector3.new(
									math.random(-12,12),
									math.random(-12,12),
									math.random(-12,12)
								)
						end
					end
				)

			elseif Distance <= 55 then

				task.delay(
					math.random(0.8,2),
					function()

						if Part
							and Part.Parent then

							Part.Anchored = false

							local Direction =
								Part.Position
								-
								ImpactPosition

							if Direction.Magnitude > 0.1 then
								Direction =
									Direction.Unit

								Part.AssemblyLinearVelocity =
									Direction
									*
									math.random(8,22)
									+
									Vector3.new(
										0,
										math.random(4,12),
										0
									)
							end
						end
					end
				)
			end
		end
	end

	local DestroyedArea =
		Instance.new("Part")

	DestroyedArea.Name =
		"Area_Destruida"

	DestroyedArea.Shape =
		Enum.PartType.Cylinder

	DestroyedArea.Size =
		Vector3.new(
			3,
			50,
			50
		)

	DestroyedArea.Position =
		ImpactPosition
		-
		Vector3.new(
			0,
			8,
			0
		)

	DestroyedArea.Orientation =
		Vector3.new(
			0,
			0,
			90
		)

	DestroyedArea.Color =
		Color3.fromRGB(
			15,
			15,
			15
		)

	DestroyedArea.Material =
		Enum.Material.Slate

	DestroyedArea.Anchored = true
	DestroyedArea.CanCollide = false
	DestroyedArea.CanTouch = false
	DestroyedArea.CanQuery = false
	DestroyedArea.Parent = workspace

	Debris:AddItem(
		DestroyedArea,
		10
	)
end

