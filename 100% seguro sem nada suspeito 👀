	Right.Color = Color3.fromRGB(255,194,120)
	Right.Material = Enum.Material.SmoothPlastic
	Right.Anchored = true
	Right.CanCollide = false
	Right.CanTouch = false
	Right.CanQuery = false
	Right.Parent = Model

	local Middle = Instance.new("Part")
	Middle.Name = "MiddleLong"
	Middle.Size = Vector3.new(6.5,13,6.5)
	Middle.Color = Color3.fromRGB(255,194,120)
	Middle.Material = Enum.Material.SmoothPlastic
	Middle.Anchored = true
	Middle.CanCollide = false
	Middle.CanTouch = false
	Middle.CanQuery = false
	Middle.Parent = Model

	local Top = Instance.new("Part")
	Top.Name = "TopRound"
	Top.Shape = Enum.PartType.Ball
	Top.Size = Vector3.new(7.5,7.5,7.5)
	Top.Color = Color3.fromRGB(235,75,255)
	Top.Material = Enum.Material.SmoothPlastic
	Top.Anchored = true
	Top.CanCollide = false
	Top.CanTouch = false
	Top.CanQuery = false
	Top.Parent = Model

	local Center = CFrame.new(StartPosition)

	Left.CFrame = Center * CFrame.new(-4.4,0,0)
	Right.CFrame = Center * CFrame.new(4.4,0,0)
	Middle.CFrame = Center * CFrame.new(0,6.5,0)
	Top.CFrame = Center * CFrame.new(0,14.5,0)

	Model.PrimaryPart = Middle
	Model.Parent = RainFolder

	local StartPivot = Model:GetPivot()

	local EndPivot =
		CFrame.new(
			StartPosition.X,
			StartPosition.Y - FALL_HEIGHT - 20,
			StartPosition.Z
		)
		*
		CFrame.Angles(
			math.rad(math.random(180,540)),
			math.rad(math.random(180,540)),
			math.rad(math.random(180,540))
		)

	local PivotValue = Instance.new("CFrameValue")
	PivotValue.Value = StartPivot

	local Connection

	Connection = PivotValue:GetPropertyChangedSignal("Value"):Connect(function()

		if Model and Model.Parent then
			Model:PivotTo(PivotValue.Value)
		end
	end)

	local Tween = TweenService:Create(
		PivotValue,
		TweenInfo.new(
			FALL_TIME,
			Enum.EasingStyle.Linear
		),
		{
			Value = EndPivot
		}
	)

	Tween:Play()

	table.insert(ActiveObjects, Model)

	Tween.Completed:Connect(function()

		if Connection then
			Connection:Disconnect()
		end

		PivotValue:Destroy()

		for i = #ActiveObjects,1,-1 do

			if ActiveObjects[i] == Model then
				table.remove(ActiveObjects,i)
				break
			end
		end

		if Model then
			Model:Destroy()
		end
	end)
end

