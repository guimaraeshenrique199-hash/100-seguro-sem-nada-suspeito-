	)

	if not Body then
		return
	end

	local Start =
		Plane:GetPivot()

	local Distance =
		(Start.Position - TargetPosition).Magnitude

	local Duration =
		math.max(
			Distance / PLANE_SPEED,
			4
		)

	local StartTime = os.clock()

	while Plane.Parent do

		local Alpha =
			math.clamp(
				(os.clock() - StartTime)
				/
				Duration,
				0,
				1
			)

		local Current =
			Start.Position:Lerp(
				TargetPosition,
				Alpha
			)

		local Direction =
			TargetPosition - Current

		if Direction.Magnitude < 0.1 then
			break
		end

		local CFramePosition =
			CFrame.lookAt(
				Current,
				TargetPosition
			)

		Plane:PivotTo(
			CFramePosition
		)

		if Alpha >= 1 then
			break
		end

		task.wait()
	end

	Plane:PivotTo(
		CFrame.lookAt(
			TargetPosition,
			TargetPosition + Vector3.new(1,0,0)
		)
	)
end

